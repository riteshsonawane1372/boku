<!doctype html>
<html lang="en" data-theme="{{.Theme}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="{{.Metadata.Generator}}">
<title>{{.Metadata.Title}}</title>
<style>
{{fontface}}
{{themecss}}
{{css}}
{{pagecss .Metadata}}
</style>
</head>
<body class="layout-{{.Layout}}">
{{if eq .Layout "paper"}}{{template "paper" .}}{{else}}

{{if eq .Layout "compact"}}
<header class="compact-cover">
  <div class="kicker">{{.Metadata.ReportType}}</div>
  <h1>{{.Metadata.Title}}</h1>
  {{with .Metadata.Subtitle}}<div class="subtitle">{{.}}</div>{{end}}
  <div class="meta">{{month .Metadata.Date}} · {{len .Sources}} sources · {{if .Metadata.Author}}{{.Metadata.Author}}{{else}}Boku research agents{{end}}</div>
</header>
{{else}}
<section class="cover">
  <div class="mesh" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="cover-top">
    <div class="kicker">{{.Metadata.ReportType}}</div>
    <div class="issue">{{month .Metadata.Date}}</div>
  </div>
  <div class="cover-main">
    <div class="rule"></div>
    <h1>{{.Metadata.Title}}</h1>
    {{with .Metadata.Subtitle}}<div class="subtitle">{{.}}</div>{{end}}
  </div>
  <div class="spacer"></div>
  {{if .Metrics}}<div class="cover-metrics">{{range .Metrics}}<div><b>{{.Value}}</b><span>{{.Label}}</span></div>{{end}}</div>{{end}}
  <div class="meta">
    <div><span>Published</span>{{month .Metadata.Date}}</div>
    <div><span>Evidence base</span>{{len .Sources}} cited sources</div>
    <div><span>Prepared by</span>{{if .Metadata.Author}}{{.Metadata.Author}}{{else}}Boku research agents{{end}}</div>
  </div>
  <div class="disclaimer">Research question: “{{.Metadata.Topic}}”. Compiled from public sources by an automated multi-agent research pipeline. Claims are cited to their sources{{if not .IncludeReferences}}{{with .Metadata.ReferencesFile}}; numbered citations refer to the companion file {{.}}{{end}}{{end}}. Verify material facts before relying on them.</div>
</section>

<nav class="toc">
  <div class="eyebrow">Contents</div>
  <h1>In this report</h1>
  <ol>
    <li><span class="n">—</span><a href="#executive-summary">{{.Labels.Summary}}</a></li>
    {{if .KeyFindings}}<li><span class="n">—</span><a href="#key-findings">{{.Labels.KeyFindings}}</a></li>{{end}}
    {{range .Sections}}<li class="major"><span class="n">{{two .Number}}</span><a href="#section-{{.Number}}">{{.Title}}{{with .Takeaway}}<small>{{plain .}}</small>{{end}}</a></li>
    {{end}}
    {{if .Conclusion}}<li><span class="n">—</span><a href="#conclusion">{{.Labels.Conclusion}}</a></li>{{end}}
    {{if .IncludeReferences}}<li><span class="n">—</span><a href="#sources">Sources</a></li>{{end}}
    {{range $i, $a := .Appendices}}<li class="minor"><span class="n">{{letter $i}}</span><a href="#appendix-{{letter $i}}">{{$a.Title}}</a></li>
    {{end}}
  </ol>
</nav>
{{end}}

<section class="chapter" id="executive-summary">
  <div class="eyebrow">{{.Labels.Summary}}</div>
  {{if ne .Layout "compact"}}<h1>{{.Metadata.Title}}</h1>{{end}}
  <div class="lead">
  {{range .ExecutiveSummary}}<p>{{inline .Text}}</p>
  {{end}}
  </div>
  {{with .Metrics}}{{template "metrics" .}}{{end}}
  {{if .Unverified}}<aside class="callout unverified"><div class="label">Not verified by fact-check</div><p>The fact checker could not verify the following. Treat any statement in this report that touches on them as unconfirmed.</p><ul>{{range .Unverified}}<li>{{.}}</li>{{end}}</ul></aside>{{end}}
</section>

{{if .KeyFindings}}
<section class="chapter" id="key-findings">
  <div class="eyebrow">{{.Labels.KeyFindings}}</div>
  <h1>What the evidence shows</h1>
  <ol class="findings">
  {{range $i, $k := .KeyFindings}}
    <li><div class="num">{{two (add $i 1)}}</div><div><h3>{{inline $k.Headline}}</h3>{{with $k.Detail}}<p>{{inline .}}</p>{{end}}</div></li>
  {{end}}
  </ol>
</section>
{{end}}

{{range .Sections}}
<section class="chapter" id="section-{{.Number}}">
  <div class="eyebrow"><b>{{two .Number}}</b> Section</div>
  <h1>{{.Title}}</h1>
  {{with .Takeaway}}<p class="takeaway">{{inline .}}</p>{{end}}
  {{template "blocks" .Blocks}}
</section>
{{end}}

{{if .Conclusion}}
<section class="chapter" id="conclusion">
  <div class="eyebrow">{{.Labels.Conclusion}}</div>
  <h1>{{.Labels.Conclusion}}</h1>
  {{range .Conclusion}}<p>{{inline .Text}}</p>
  {{end}}
</section>
{{end}}

{{if not .IncludeReferences}}
<p class="refs-note">Numbered citations refer to {{len .Sources}} sources listed in {{with .Metadata.ReferencesFile}}the companion file <strong>{{.}}</strong>{{else}}the run's references file{{end}}. Re-render with <code>--save-ref</code> to include them here.</p>
{{else}}
<section class="chapter" id="sources">
  <div class="eyebrow">References</div>
  <h1>Sources</h1>
  <ol class="sources">
  {{range .Sources}}
    <li id="src-{{.Number}}">
      <div class="n">{{.Number}}</div>
      <div>
        <div class="title">{{.Title}}</div>
        <div class="meta">{{with .Publisher}}{{.}} · {{end}}{{with date .Published}}Published {{.}} · {{end}}Accessed {{day .Accessed}} · {{.TierLabel}}</div>
        <div class="url"><a href="{{.URL}}">{{.URL}}</a></div>
      </div>
    </li>
  {{end}}
  </ol>
</section>
{{end}}

{{range $i, $a := .Appendices}}
<section class="chapter" id="appendix-{{letter $i}}">
  <div class="eyebrow">Appendix {{letter $i}}</div>
  <h1>{{$a.Title}}</h1>
  {{template "blocks" $a.Blocks}}
</section>
{{end}}
{{end}}
</body>
</html>

{{define "metrics"}}
<div class="metrics n{{len .}}">
  {{range .}}<div class="metric{{with .Trend}} {{.}}{{end}}">
    <div class="value">{{.Value}}{{with trend .Trend}}<i>{{.}}</i>{{end}}</div>
    <div class="name">{{.Label}}</div>
    {{with .Detail}}<div class="detail">{{inline .}}</div>{{end}}
  </div>{{end}}
</div>
{{end}}

{{define "blocks"}}
{{range .}}
  {{if eq .Type "subheading"}}<h2>{{.Text}}</h2>
  {{else if eq .Type "paragraph"}}<p>{{inline .Text}}</p>
  {{else if eq .Type "bullets"}}<ul class="bullets">{{range .Items}}<li>{{inline .}}</li>{{end}}</ul>
  {{else if eq .Type "callout"}}<aside class="callout {{.Tone}}"><div class="label">{{calloutLabel .}}</div><p>{{inline .Text}}</p></aside>
  {{else if eq .Type "metrics"}}{{with .Title}}<div class="metrics-title">{{.}}</div>{{end}}{{template "metrics" .Metrics}}
  {{else if eq .Type "table"}}
  <figure class="table">
    <div class="caption"><span class="label">Table {{.Number}}</span>{{.Title}}</div>
    <table{{if eq .Title "Cited findings"}} class="register"{{end}}>
      <thead><tr>{{range .Columns}}<th>{{breakLong .}}</th>{{end}}</tr></thead>
      <tbody>{{range .Rows}}<tr>{{range .}}<td>{{cell .}}</td>{{end}}</tr>{{end}}</tbody>
    </table>
    {{with sources .}}<div class="source-line">{{.}}</div>{{end}}
  </figure>
  {{else if eq .Type "chart"}}
  <figure class="chart">
    <figcaption><span class="label">Figure {{.Number}}</span>{{.Chart.Title}}<span class="units">{{.Chart.Units}}</span></figcaption>
    {{chart .}}
    <div class="source-line">{{sources .}}</div>
  </figure>
  {{else if eq .Type "diagram"}}
  <figure class="diagram">
    <figcaption><span class="label">Figure {{.Number}}</span>{{.Diagram.Title}}</figcaption>
    {{diagram .}}
    {{with sources .}}<div class="source-line">{{.}}</div>{{end}}
  </figure>
  {{end}}
{{end}}
{{end}}

{{/* Paper layout: a single-column academic paper. Title block, abstract,
     numbered sections and subsections (CSS counters), captioned figures and
     tables, bracketed citations and a reference list. */}}
{{define "paper"}}
<header class="paper-head">
  <h1 class="paper-title">{{.Metadata.Title}}</h1>
  {{with .Metadata.Subtitle}}<div class="paper-subtitle">{{.}}</div>{{end}}
  <div class="paper-authors">{{if .Metadata.Author}}{{.Metadata.Author}}{{else}}Boku research agents{{end}}<sup>*</sup></div>
  <div class="paper-date">{{.Metadata.ReportType}} · {{month .Metadata.Date}}</div>
</header>

<section class="abstract" id="executive-summary">
  <h2>{{.Labels.Summary}}</h2>
  {{range .ExecutiveSummary}}<p>{{inline .Text}}</p>
  {{end}}
  {{with .Keywords}}<p class="keywords"><b>Keywords:</b> {{join . "; "}}</p>{{end}}
</section>
{{if .Unverified}}<aside class="callout unverified"><div class="label">Not verified by fact-check</div><p>The fact checker could not verify the following. Treat any statement in this paper that touches on them as unconfirmed.</p><ul>{{range .Unverified}}<li>{{.}}</li>{{end}}</ul></aside>{{end}}

{{if .KeyFindings}}
<section class="highlights" id="key-findings">
  <h2>{{.Labels.KeyFindings}}</h2>
  <ul>{{range .KeyFindings}}<li><b>{{inline .Headline}}</b>{{with .Detail}} — {{inline .}}{{end}}</li>{{end}}</ul>
</section>
{{end}}

{{range .Sections}}
<section class="paper-section" id="section-{{.Number}}">
  <h1>{{.Title}}</h1>
  {{template "blocks" .Blocks}}
</section>
{{end}}

{{if .Conclusion}}
<section class="paper-section" id="conclusion">
  <h1>{{.Labels.Conclusion}}</h1>
  {{range .Conclusion}}<p>{{inline .Text}}</p>
  {{end}}
</section>
{{end}}

{{if .IncludeReferences}}
<section class="paper-refs" id="sources">
  <h1>References</h1>
  <ol class="paper-sources">
  {{range .Sources}}
    <li id="src-{{.Number}}"><span class="n">[{{.Number}}]</span> {{with .Publisher}}{{.}}. {{end}}<i>{{.Title}}</i>.{{with date .Published}} {{.}}.{{end}} <span class="url"><a href="{{.URL}}">{{.URL}}</a></span>. Accessed {{day .Accessed}}.</li>
  {{end}}
  </ol>
</section>
{{else}}
<p class="refs-note">Numbered citations refer to {{len .Sources}} sources listed in {{with .Metadata.ReferencesFile}}the companion file <strong>{{.}}</strong>{{else}}the run's references file{{end}}. Re-render with <code>--save-ref</code> to include them here.</p>
{{end}}

{{range $i, $a := .Appendices}}
<section class="paper-appendix" id="appendix-{{letter $i}}">
  <h1><span class="secnum">{{letter $i}}</span>{{$a.Title}}</h1>
  {{template "blocks" $a.Blocks}}
</section>
{{end}}

<p class="paper-footnote"><sup>*</sup>Compiled from public sources by Boku, an automated multi-agent research pipeline, in response to: “{{.Metadata.Topic}}”. This paper reports no new experiments; every result is drawn from the cited work. Verify material facts before relying on them.</p>
{{end}}
