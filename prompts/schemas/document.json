{
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "report_type": {
      "type": "string"
    },
    "executive_summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "key_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "headline": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "headline",
          "detail"
        ]
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "paragraph",
                    "subheading",
                    "bullets",
                    "callout",
                    "table",
                    "chart",
                    "diagram",
                    "metrics"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "tone": {
                  "type": "string",
                  "enum": [
                    "insight",
                    "caution",
                    "estimate",
                    "note",
                    "unverified"
                  ]
                },
                "finding_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "as_of": {
                  "type": "string"
                },
                "chart": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "column",
                        "stacked",
                        "bar",
                        "line",
                        "area",
                        "donut"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "units": {
                      "type": "string"
                    },
                    "labels": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "series": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "values": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            }
                          }
                        },
                        "required": [
                          "name",
                          "values"
                        ]
                      }
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "title",
                    "units",
                    "labels",
                    "series"
                  ]
                },
                "diagram": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "architecture",
                        "process",
                        "timeline"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "nodes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "group": {
                            "type": "string"
                          },
                          "detail": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "label"
                        ]
                      }
                    },
                    "edges": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "from": {
                            "type": "string"
                          },
                          "to": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "from",
                          "to"
                        ]
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "title",
                    "nodes",
                    "edges"
                  ]
                },
                "metrics": {
                  "type": "array",
                  "description": "metrics blocks only: 2-4 tiles",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string",
                        "description": "the number with its unit, at most 18 characters: 'USD 4.2bn', '62%', '3.4x'"
                      },
                      "label": {
                        "type": "string",
                        "description": "what the number measures, a few words"
                      },
                      "detail": {
                        "type": "string",
                        "description": "period, comparison or caveat, with a citation"
                      },
                      "trend": {
                        "type": "string",
                        "enum": [
                          "up",
                          "down",
                          "flat"
                        ]
                      },
                      "finding_ids": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "value",
                      "label",
                      "finding_ids"
                    ]
                  }
                }
              },
              "required": [
                "type"
              ]
            }
          },
          "takeaway": {
            "type": "string",
            "description": "the section's point in one sentence; shown under the heading and as the slide headline"
          }
        },
        "required": [
          "title",
          "blocks"
        ]
      }
    },
    "conclusion": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary_title": {
      "type": "string",
      "description": "optional heading for the executive summary, e.g. 'The answer'"
    },
    "key_findings_title": {
      "type": "string"
    },
    "conclusion_title": {
      "type": "string",
      "description": "optional heading for the conclusion, e.g. 'Recommendation'"
    },
    "layout": {
      "type": "string",
      "enum": [
        "full",
        "compact"
      ]
    },
    "keywords": {
      "type": "array",
      "description": "whitepapers only: 4-8 index terms shown under the abstract",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "array",
      "description": "0-4 headline numbers for the whole report",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "the number with its unit, at most 18 characters: 'USD 4.2bn', '62%', '3.4x'"
          },
          "label": {
            "type": "string",
            "description": "what the number measures, a few words"
          },
          "detail": {
            "type": "string",
            "description": "period, comparison or caveat, with a citation"
          },
          "trend": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "flat"
            ]
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "value",
          "label",
          "finding_ids"
        ]
      }
    },
    "theme": {
      "type": "string",
      "enum": [
        "aurora",
        "meridian",
        "ember",
        "slate"
      ],
      "description": "visual template that suits the subject"
    }
  },
  "required": [
    "title",
    "subtitle",
    "report_type",
    "executive_summary",
    "sections"
  ]
}
