{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number"
          },
          "as_of": {
            "type": "string",
            "description": "date or period the claim describes: YYYY-MM-DD, YYYY-MM, YYYY, Q1 2026, FY2025"
          },
          "kind": {
            "type": "string",
            "enum": [
              "reported",
              "estimated",
              "derived",
              "inference"
            ]
          },
          "topic": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "claim",
          "evidence",
          "source_refs",
          "confidence",
          "as_of",
          "kind"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "description": "short local id, e.g. s1"
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "published_at": {
            "type": "string",
            "description": "YYYY-MM-DD, YYYY-MM or YYYY; empty if unknown"
          },
          "source_type": {
            "type": "string"
          },
          "tier": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4
            ]
          }
        },
        "required": [
          "ref",
          "url",
          "title",
          "tier"
        ]
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "summary",
    "findings",
    "sources"
  ]
}
